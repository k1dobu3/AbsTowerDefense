:root {
}

Label {
    color: white;
    align-self: center;
}

#GameRrealtimeStats {
    display: flex;
    max-width: 250px;
    background-color: rgba(0, 0, 0, 0.7);
    opacity: 1;
}

#LABEL_MonsterSpawnTimer {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(120, 255, 120);
    unity-text-align: left;
    width: 100%;
    height: 80px;
    background: rgba(0, 0, 0, 0);
}
